---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
---

<SiteLayout
  lang="en"
  title="Business Brokers in Vietnam | Archway Business Brokers"
  description="Archway Business Brokers helps owners sell or transfer operating businesses in Vietnam with annual revenue from VND 3 billion, connects them with suitable buyers and guides the transaction process. Initial discussions are free and confidential."
>
  <main class="relative min-h-screen overflow-hidden bg-[var(--color-ink)] text-[var(--color-paper)]">
    <SiteNavigation lang="en" />
    <img
      class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-center"
      src="/assets/hero-poster.jpg"
      alt=""
      aria-hidden="true"
      width="1280"
      height="720"
    />
    <video
      class="pointer-events-none absolute inset-0 z-[1] h-full w-full object-cover object-center motion-reduce:hidden"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      poster="/assets/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/assets/hero-video.mp4" type="video/mp4" />
      <source src="/assets/hero-video.webm" type="video/webm" />
    </video>
    <div class="pointer-events-none absolute inset-0 z-[2] bg-[var(--color-scrim)]"></div>

    <div class="relative z-[3] flex min-h-screen flex-col justify-between px-6 py-6 sm:px-10 sm:py-8">
      <div class="flex flex-1 flex-col items-center justify-center gap-7 py-12 text-center sm:gap-9">
        <img
          class="h-24 w-24"
          src="/favicon.svg"
          alt="ABB logo"
          width="96"
          height="96"
          decoding="async"
        />
        <div class="flex flex-col items-center font-medium leading-[0.86] text-[var(--color-paper)]" aria-label="Archway Business Brokers">
          <span class="text-[clamp(2.25rem,8vw,7rem)]">Archway</span>
          <span class="ml-[0.16em] text-[clamp(1.05rem,3.7vw,3.6rem)] text-[var(--color-paper)]">Business Brokers</span>
        </div>

        <div class="flex max-w-[48rem] flex-col items-center gap-3">
          <h1 class="m-0 max-w-[48rem] text-[clamp(1rem,1.35vw,1.4rem)] font-normal leading-[1.4] text-[var(--color-paper)]">
            Business Brokers in Vietnam
          </h1>
          <p class="m-0 max-w-[48rem] text-[clamp(1rem,1.35vw,1.4rem)] font-normal leading-[1.4] text-[var(--color-paper)]">
            Archway Business Brokers helps owners sell or transfer operating businesses in Vietnam with annual revenue from VND 3 billion, connects them with suitable buyers and guides the transaction process. Initial discussions are free and confidential.
          </p>
        </div>

        <div class="flex w-full flex-wrap items-center justify-center gap-3">
          <a
            class="inline-flex w-full max-w-full items-center justify-center border-0 bg-[var(--color-accent)] px-6 py-[0.78rem] text-center text-[var(--color-paper)] uppercase hover:bg-[var(--color-accent-hover)] focus-visible:outline-2 focus-visible:outline-[var(--color-paper)] focus-visible:outline-offset-4 sm:w-auto"
            href="/en/sell-your-business/"
          >
            Discuss selling or transferring your business
          </a>
          <a
            class="inline-flex w-full max-w-full items-center justify-center border border-[var(--color-paper)] bg-transparent px-6 py-[0.78rem] text-center text-[var(--color-paper)] hover:bg-[var(--color-paper)] hover:text-[var(--color-ink)] focus-visible:outline-2 focus-visible:outline-[var(--color-paper)] focus-visible:outline-offset-4 sm:w-auto"
            href="tel:+84346346550"
          >
            Call (+84) 346-346-550
          </a>
        </div>
      </div>

      <footer id="contact" class="z-[3] flex flex-col items-center gap-2 pb-1 text-center text-sm sm:gap-3 sm:text-base">
        <p class="m-0">Archway Business Brokers</p>
        <p class="m-0 max-w-[62rem] leading-[1.5]">
          17th Floor, Vincom Center Building, 72 Le Thanh Ton Street, District 1, Ho Chi Minh City, Vietnam
        </p>
        <div class="flex flex-col items-center gap-2">
          <a
            class="inline-flex items-center gap-2 text-[var(--color-paper)] no-underline hover:text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-[var(--color-paper)] focus-visible:outline-offset-4"
            href="tel:+84346346550"
          >
            <span>Phone: (+84) 346-346-550</span>
          </a>
          <a
            class="inline-flex items-center text-[var(--color-paper)] no-underline hover:text-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-4"
            href="mailto:brokers@archway.vn"
          >
            <span>brokers@archway.vn</span>
          </a>
        </div>
      </footer>
    </div>
  </main>
</SiteLayout>
