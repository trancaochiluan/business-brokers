const copy = isVietnamese
  ? {
      pageTitle: 'Chính sách quyền riêng tư | Archway Business Brokers',
      description: 'Chính sách quyền riêng tư của Archway Business Brokers.',
      heading: 'Chính sách quyền riêng tư',
      intro: 'Quyền riêng tư của Quý khách cực kỳ quan trọng đối với chúng tôi. Chúng tôi mong trải nghiệm của Quý khách trên mạng Internet được thoải mái và bổ ích nhất có thể, và mong Quý khách sử dụng kho thông tin, công cụ và cơ hội rộng lớn của mạng Internet với sự tin tưởng trọn vẹn.',
      lastUpdated: 'Cập nhật lần cuối: 26/08/2026',
      sections: vietnameseSections,
      footerAddress: 'Tầng 17, Tòa nhà Vincom Center, 72 đường Lê Thánh Tôn, Quận 1, Thành phố Hồ Chí Minh, Việt Nam',
      footerPhone: 'Điện thoại: 0346-346-550',
    }
  : {
      pageTitle: 'Privacy Policy | Archway Business Brokers',
      description: 'The Privacy Policy of Archway Business Brokers.',
      heading: 'Privacy Policy',
      intro: 'Your privacy is extremely important to us. We want your experience on the Internet to be as comfortable and useful as possible, and we want you to use the Internet’s broad supply of information, tools and opportunities with complete confidence.',
      lastUpdated: 'Last updated: 26/08/2026',
      sections: englishSections,
      footerAddress: '17th Floor, Vincom Center Building, 72 Le Thanh Ton Street, District 1, Ho Chi Minh City, Vietnam',
      footerPhone: 'Phone: (+84) 346-346-550',
    };

const breadcrumbItems = [
  { name: isVietnamese ? 'Trang chủ' : 'Home', href: isVietnamese ? '/' : '/en/' },
  { name: copy.heading },
];
---

<SiteLayout lang={lang} noIndex title={copy.pageTitle} description={copy.description} breadcrumbs={breadcrumbItems}>
  <div class="flex min-h-dvh flex-col bg-[var(--color-muted)] text-[var(--color-ink)]">
    <div class="relative min-h-[60px] bg-[var(--color-paper)]">
      <SiteNavigation lang={lang} showBrand theme="light" />
    </div>

    <main>
      <PageHero lang={lang} items={breadcrumbItems} heading={copy.heading} intro={copy.intro} />

      <section class="bg-[var(--color-paper)] px-6 py-10 sm:px-10 sm:py-14">
        <div class="mx-auto grid w-full max-w-3xl gap-3 text-base leading-7 text-[var(--color-ink)]">
          {copy.sections.map((section, index) => (
            <section aria-labelledby={`privacy-section-${index + 1}`}>
              <h2 id={`privacy-section-${index + 1}`} class="mt-5 text-[clamp(1.5rem,3vw,1.875rem)] font-medium leading-tight text-[var(--color-ink)] first:mt-0">{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p class="mt-3">{paragraph}</p>)}
              {section.list && (
                <ul class="mt-3 grid list-disc gap-2 pl-5">
                  {section.list.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))}
          <p class="mt-4 text-sm leading-6 text-[var(--color-ink)]">{copy.lastUpdated}</p>
        </div>
      </section>
    </main>

    <SiteFooter theme="dark" address={copy.footerAddress} phone={copy.footerPhone} />
  </div>
</SiteLayout>
