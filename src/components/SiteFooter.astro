---
interface Props {
  address: string;
  phone: string;
  theme?: 'dark' | 'light';
}

const { address, phone, theme = 'dark' } = Astro.props;
const footerClass = theme === 'light'
  ? 'mt-auto bg-[var(--color-paper)] px-6 py-6 text-center text-sm text-[var(--color-ink)] sm:px-10'
  : 'mt-auto bg-[var(--color-ink)] px-6 py-6 text-center text-sm text-[var(--color-paper)] sm:px-10';
const linkClass = theme === 'light'
  ? 'text-[var(--color-ink)] underline-offset-4 hover:text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-[var(--color-ink)] focus-visible:outline-offset-4'
  : 'text-[var(--color-paper)] underline-offset-4 hover:text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-[var(--color-paper)] focus-visible:outline-offset-4';
---

<footer class={footerClass}>
  <p class="m-0">Archway Business Brokers, {address}</p>
  <div class="mt-2 flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
    <a class={`inline-flex items-center gap-2 ${linkClass}`} href="tel:+84346346550">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.3 4.7 7 3a1.4 1.4 0 0 1 2 .1l2.1 2.4a1.4 1.4 0 0 1 .1 1.8L9.9 9a14.3 14.3 0 0 0 5.1 5.1l1.7-1.3a1.4 1.4 0 0 1 1.8.1l2.4 2.1a1.4 1.4 0 0 1 .1 2l-1.7 1.7c-.8.8-2 1.1-3.1.7A18.4 18.4 0 0 1 4.6 7.8c-.4-1.1-.1-2.3.7-3.1Z" />
      </svg>
      <span>{phone}</span>
    </a>
    <a class={`inline-flex items-center gap-2 ${linkClass}`} href="mailto:brokers@archway.vn">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
      </svg>
      <span>brokers@archway.vn</span>
    </a>
  </div>
</footer>
